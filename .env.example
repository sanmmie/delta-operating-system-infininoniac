# Copy this file to .env and replace every placeholder before deployment.
POSTGRES_PASSWORD=replace-with-a-long-random-password
REDIS_PASSWORD=replace-with-a-long-random-password
SECRET_KEY=replace-with-at-least-32-random-characters
GRAFANA_PASSWORD=replace-with-a-long-random-password

# Comma-separated browser origins permitted to make credentialed API requests.
CORS_ORIGINS=https://app.example.com
